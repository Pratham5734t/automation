# Source Instagram account credentials (for scraping)
SOURCE_USERNAME=source_instagram_account
SOURCE_PASSWORD=source_instagram_password

# Target Instagram account credentials (for uploading)
TARGET_USERNAME=target_instagram_account
TARGET_PASSWORD=target_instagram_password

# Instagram accounts to scrape content from (comma-separated)
ACCOUNTS_TO_SCRAPE=account1,account2,account3

# Telegram Bot configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Number of posts to fetch per account per run
MAX_POSTS_PER_ACCOUNT=5

# Excel file path for storing post history
HISTORY_FILE=history.xlsx
